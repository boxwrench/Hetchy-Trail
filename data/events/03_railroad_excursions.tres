[gd_resource type="Resource" script_class="EventCard" load_steps=5 format=3]

[ext_resource type="Script" path="res://resources/event_card.gd" id="1"]
[ext_resource type="Script" path="res://resources/event_choice.gd" id="2"]

[sub_resource type="Resource" id="choice_excursion"]
script = ExtResource("2")
label = "Run the public excursion"
outcome_text = "San Franciscans ride the rails into the high country and see their water system taking shape. Support for the bonds grows."
funds_delta = -1
public_support_delta = 2
time_delta_seasons = 1

[sub_resource type="Resource" id="choice_freight"]
script = ExtResource("2")
label = "Keep every train on freight"
outcome_text = "The cement keeps moving and the schedule tightens, but the public only reads about the project in the papers."
time_delta_seasons = -1

[resource]
script = ExtResource("1")
event_id = &"railroad_excursions"
title = "Bring the Public to the Project"
phase_id = &"phase_1"
location_name = "Hetch Hetchy Railroad"
mile_start = 0
mile_end = 49
historical_year_start = 1916
historical_year_end = 1923
event_description = "Dedicate scarce passenger capacity to a public inspection tour, or reserve every train for freight."
historical_fact = "San Francisco residents were taken on project excursions, helping residents see the work and strengthening public interest in the water project and its financing."
choices = Array[ExtResource("2")]([SubResource("choice_excursion"), SubResource("choice_freight")])
canonical_choice = 0
is_fixed = false
weight = 2.0
required_flags = Array[StringName]([&"railroad_operational"])
historical_source_note = "SFPUC historical materials, summarized in docs/Hetchy Trail Historical Game Mapping.pdf, section 5."
assumption_note = "Resource values are game-balancing numbers, not historical measurements."
