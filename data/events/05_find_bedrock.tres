[gd_resource type="Resource" script_class="EventCard" format=3]

[ext_resource type="Script" path="res://resources/event_card.gd" id="1"]
[ext_resource type="Script" path="res://resources/event_choice.gd" id="2"]

[sub_resource type="Resource" id="Resource_8w30q"]
script = ExtResource("2")
label = "Fund full excavation and river diversion"
outcome_text = "The Tuolumne is turned through a diversion tunnel and crews dig through glacial boulders to sound bedrock. In 1923, after continuous all-season work, the first O'Shaughnessy Dam stands complete."
funds_delta = -3
water_readiness_delta = 3
crew_wellbeing_delta = -1
time_delta_seasons = 2
granted_flags = Array[StringName]([&"dam_complete"])

[resource]
script = ExtResource("1")
event_id = &"find_bedrock"
title = "Find Bedrock"
phase_id = &"phase_1"
location_name = "O'Shaughnessy Dam site"
mile_start = 10
mile_end = 33
historical_year_start = 1919
historical_year_end = 1923
event_description = "Test borings reveal that the foundation excavation will be much deeper than the visible valley floor suggests. Full excavation and river diversion must be funded before concrete placement can continue."
historical_fact = "Work required a roughly 1,000-foot diversion tunnel and deep excavation through glacial boulders, sand and other material before sound bedrock could be reached. The initial dam was completed in 1923 after continuous, all-season work."
choices = Array[ExtResource("2")]([SubResource("Resource_8w30q")])
is_fixed = true
required_flags = Array[StringName]([&"high_sierra_access_complete", &"construction_power_available"])
historical_source_note = "SFPUC 2005 history, \"Dam & Tunnel Construction Starts in the High Sierra\", p. 34 [SFPUC-2005]. Design mapping: docs/Hetchy Trail Historical Game Mapping.pdf, section 5."
assumption_note = "There was no cheap alternative to full excavation, so this card offers a single choice. Requiring construction power first mirrors Early Intake electricity reaching the dam site before major dam construction began in 1919."
