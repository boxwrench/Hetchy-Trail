[ext_resource type="Script" path="res://resources/event_choice.gd" id="2"]

[sub_resource type="Resource" id="Resource_j6lau"]
script = ExtResource("2")
label = "Wait out the storms"
outcome_text = "Freight sits at the railhead below the snow line. The camps hold on through a hard mountain winter."
crew_wellbeing_delta = -1
time_delta_seasons = 1

[resource]
script = ExtResource("1")
event_id = &"sierra_snows"
title = "Sierra Snows"
phase_id = &"phase_1"
location_name = "Mountain roads above Hetch Hetchy Junction"
mile_end = 33
historical_year_start = 1914
historical_year_end = 1925
event_description = "Snow closes the mountain roads. Without the railroad, cement, food and equipment cannot reach the high camps until the passes clear."
historical_fact = "Mountain roads to the project were regularly blocked by snow. The Hetch Hetchy Railroad, completed in 1917, operated through winter and kept supplies moving when the roads could not."
choices = Array[ExtResource("2")]([SubResource("Resource_j6lau")])
weight = 3.0
blocked_by_flags = Array[StringName]([&"railroad_operational"])
historical_source_note = "SFPUC 2005 history, \"Early Intake Powerhouse and Lake Eleanor\", p. 32 [SFPUC-2005]. Records that motor roads were snowbound. Also NPS [NPS-YOSE] on year-round rail movement. Design mapping: docs/Hetchy Trail Historical Game Mapping.pdf, section 5."
assumption_note = "This card is gameplay-derived rather than a specific documented incident: it exists so the railroad decision has a visible consequence. The underlying condition (snowbound roads, railroad as the winter lifeline) is historical."
