[gd_resource type="Resource" script_class="EventCard" format=3]

[ext_resource type="Script" path="res://resources/event_card.gd" id="1"]
[ext_resource type="Script" path="res://resources/event_choice.gd" id="2"]

[sub_resource type="Resource" id="Resource_wceya"]
script = ExtResource("2")
label = "Fully service the camps"
outcome_text = "Water, electricity, telephones and roads reach every camp before the crews spread out. Workers stay, and the tunnel work runs with fewer interruptions."
funds_delta = -2
crew_wellbeing_delta = 2
time_delta_seasons = -1
granted_flags = Array[StringName]([&"foothill_camps_established"])

[sub_resource type="Resource" id="Resource_klfp1"]
script = ExtResource("2")
label = "Set up bare camps"
outcome_text = "Tents and cookhouses go up fast and cheap. Workers drift away almost as fast, and every departure slows a heading."
funds_delta = -1
crew_wellbeing_delta = -2
time_delta_seasons = 1
granted_flags = Array[StringName]([&"foothill_camps_established"])

[resource]
script = ExtResource("1")
event_id = &"six_camps_in_the_foothills"
title = "Six Camps in the Foothills"
phase_id = &"phase_3"
location_name = "Foothill Tunnel camps"
mile_start = 34
mile_end = 49
historical_year_start = 1925
historical_year_end = 1926
event_description = "Decide how much infrastructure to provide before distributing the tunneling crews. Well-supplied camps retain workers and reduce future interruptions."
historical_fact = "Six construction camps supported Foothill Tunnel work. City crews installed camp water, electricity, telephones, roads and other support facilities before and during excavation."
choices = Array[ExtResource("2")]([SubResource("Resource_wceya"), SubResource("Resource_klfp1")])
is_fixed = true
required_flags = Array[StringName]([&"moccasin_power_available"])
historical_source_note = "SFPUC 2005 history, \"Foothill Tunnel\", p. 37 [SFPUC-2005]. Design mapping: docs/Hetchy Trail Historical Game Mapping.pdf, section 5."
assumption_note = "Resource values are game-balancing numbers, not historical measurements."
