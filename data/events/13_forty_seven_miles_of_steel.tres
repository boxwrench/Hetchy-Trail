[gd_resource type="Resource" script_class="EventCard" format=3]

[ext_resource type="Script" path="res://resources/event_card.gd" id="1"]
[ext_resource type="Script" path="res://resources/event_choice.gd" id="2"]

[sub_resource type="Resource" id="Resource_23a5y"]
script = ExtResource("2")
label = "Distribute the crews along the line"
outcome_text = "Delivery, trenching, welding, riveting and inspection run simultaneously along nearly forty-eight miles of valley. The pipeline goes in fast, and everyone feels the pace."
funds_delta = -2
water_readiness_delta = 2
crew_wellbeing_delta = -1
time_delta_seasons = -2
granted_flags = Array[StringName]([&"san_joaquin_pipeline_complete"])

[resource]
script = ExtResource("1")
event_id = &"forty_seven_miles_of_steel"
title = "Forty-Seven Miles of Steel"
phase_id = &"phase_4"
location_name = "San Joaquin Pipeline No. 1"
mile_start = 90
mile_end = 126
historical_year_start = 1931
historical_year_end = 1932
event_description = "Divide crews among pipe delivery, trench preparation, welding, riveting and inspection. Distributed work is faster but increases coordination and fatigue."
historical_fact = "The first San Joaquin pipeline extended approximately 47.5 miles between Oakdale and Tesla. Built in 1931-1932, it used welded and riveted steel sections ranging from about 56 to 72 inches in diameter, with an initial capacity of approximately 70 million gallons per day."
choices = Array[ExtResource("2")]([SubResource("Resource_23a5y")])
is_fixed = true
required_flags = Array[StringName]([&"row_acquired"])
historical_source_note = "SFPUC historical materials, summarized in docs/Hetchy Trail Historical Game Mapping.pdf, section 5."
assumption_note = "Single choice: the distributed-crew method is how the pipeline was actually built, and no alternative is documented in the brief."
