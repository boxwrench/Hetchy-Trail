[gd_resource type="Resource" script_class="EventCard" format=3]

[ext_resource type="Script" path="res://resources/event_card.gd" id="1"]
[ext_resource type="Script" path="res://resources/event_choice.gd" id="2"]

[sub_resource type="Resource" id="Resource_vkcna"]
script = ExtResource("2")
label = "Commit to the gravity tunnel"
outcome_text = "Twenty-eight and a half miles of bore through the Coast Range: slower and costlier to build, but water will flow to the city by gravity alone, forever."
funds_delta = -3
water_readiness_delta = 3
time_delta_seasons = 2
granted_flags = Array[StringName]([&"coast_range_committed", &"gravity_tunnel_chosen"])

[sub_resource type="Resource" id="Resource_22vrm"]
script = ExtResource("2")
label = "Build the pumped pipeline instead"
outcome_text = "A cheaper, faster line over the hills - with less capacity and pumping bills the city will pay every year it operates."
funds_delta = -2
water_readiness_delta = 1
time_delta_seasons = -1
granted_flags = Array[StringName]([&"coast_range_committed", &"pumped_alternative_chosen"])

[resource]
script = ExtResource("1")
event_id = &"gravity_or_pumps"
title = "Gravity or Pumps?"
phase_id = &"phase_5"
location_name = "Tesla Portal"
mile_start = 97
mile_end = 126
historical_year_start = 1927
historical_year_end = 1927
event_description = "Make the project's defining long-term decision. The gravity tunnel is slower and more expensive to construct, while the debated pumped alternative would provide less capacity and continuing operating costs. Only the gravity option follows the completed historical system."
historical_fact = "Construction of the 28.5-mile Coast Range Tunnel was delayed until 1927. A pumped pipeline was discussed as an alternative, but the gravity tunnel offered greater capacity without permanent pumping costs."
choices = Array[ExtResource("2")]([SubResource("Resource_vkcna"), SubResource("Resource_22vrm")])
is_fixed = true
historical_source_note = "SFPUC 2005 history, \"San Joaquin Pipelines\", p. 38 [SFPUC-2005]. Design mapping: docs/Hetchy Trail Historical Game Mapping.pdf, section 5."
assumption_note = "The pumped alternative's recurring cost is implemented as an extra funds point every winter (the pumped_alternative_chosen flag), approximating the brief's 'Funds -1 during every later operating chapter.'"
