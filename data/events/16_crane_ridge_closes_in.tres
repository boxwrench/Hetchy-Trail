[gd_resource type="Resource" script_class="EventCard" format=3]

[ext_resource type="Script" path="res://resources/event_card.gd" id="1"]
[ext_resource type="Script" path="res://resources/event_choice.gd" id="2"]

[sub_resource type="Resource" id="Resource_diikm"]
script = ExtResource("2")
label = "Pause and adopt gunite support rings"
outcome_text = "Crews excavate an oversized bore and build gunite rings with room for the mountain to move. The ground squeezes; the tunnel holds."
funds_delta = -2
water_readiness_delta = 2
crew_wellbeing_delta = 1
time_delta_seasons = 1

[sub_resource type="Resource" id="Resource_q0032"]
script = ExtResource("2")
label = "Keep the timber supports"
outcome_text = "Timber that held everywhere else crushes like kindling here. Sections have to be re-excavated, and the crews lose faith in the ground over their heads."
water_readiness_delta = 2
crew_wellbeing_delta = -2
time_delta_seasons = 2

[resource]
script = ExtResource("1")
event_id = &"crane_ridge_closes_in"
title = "Crane Ridge Closes In"
phase_id = &"phase_5"
location_name = "Crane Ridge, Coast Range Tunnel"
mile_start = 100
mile_end = 126
historical_year_start = 1928
historical_year_end = 1933
event_description = "Previously reliable timber supports begin crushing. Pause excavation and adopt the larger gunite-ring design, or press on with the old method."
historical_fact = "At Crane Ridge, approximately 2,500 feet below the surface, swelling ground squeezed the excavated opening. In one reported section, an approximately 18-foot opening contracted to about three feet within 24 hours. Crews responded by excavating an oversized bore and constructing gunite support rings with room for the ground to move."
choices = Array[ExtResource("2")]([SubResource("Resource_diikm"), SubResource("Resource_q0032")])
weight = 2.0
required_flags = Array[StringName]([&"coast_range_committed"])
historical_source_note = "SFPUC historical materials, summarized in docs/Hetchy Trail Historical Game Mapping.pdf, section 5."
assumption_note = "Both choices grant the same readiness because the section was ultimately completed either way; the difference is time and crew cost."
