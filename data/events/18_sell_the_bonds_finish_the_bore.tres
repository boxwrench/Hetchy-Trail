[gd_resource type="Resource" script_class="EventCard" format=3]

[ext_resource type="Script" path="res://resources/event_card.gd" id="1"]
[ext_resource type="Script" path="res://resources/event_choice.gd" id="2"]

[sub_resource type="Resource" id="Resource_kofp8"]
script = ExtResource("2")
label = "Campaign for the bonds"
outcome_text = "The 1932 bond issue passes. Suspended headings restart, the surveys hold true, and on January 5, 1934 the Mitchell and Mocho headings meet underground."
funds_delta = 3
public_support_delta = 1
water_readiness_delta = 3
time_delta_seasons = -2
granted_flags = Array[StringName]([&"coast_range_tunnel_complete"])

[sub_resource type="Resource" id="Resource_2faa8"]
script = ExtResource("2")
label = "Delay the bond vote"
outcome_text = "The headings sit idle and crews drift to other work. The vote will have to be attempted again."
crew_wellbeing_delta = -1
time_delta_seasons = 2
repeat_card = true

[resource]
script = ExtResource("1")
event_id = &"sell_the_bonds_finish_the_bore"
title = "Sell the Bonds, Finish the Bore"
phase_id = &"phase_5"
location_name = "Coast Range Tunnel headings"
mile_start = 122
mile_end = 126
historical_year_start = 1932
historical_year_end = 1934
event_description = "Active headings are running out of authorized funding. Conduct a public bond campaign, restart the crews and preserve enough surveying precision for the final breakthrough."
historical_fact = "Financial shortages temporarily suspended portions of the tunnel work. A 1932 bond issue provided additional money, and the last Coast Range Tunnel connection was made on January 5, 1934, between the Mitchell and Mocho headings."
choices = Array[ExtResource("2")]([SubResource("Resource_kofp8"), SubResource("Resource_2faa8")])
is_fixed = true
required_flags = Array[StringName]([&"mitchell_memorial_observed"])
historical_source_note = "SFPUC 2005 history, \"Coast Range Tunnel\", p. 40 [SFPUC-2005]. The $6.5 million 1932 issue is listed among the seven Hetch Hetchy bond issues in \"Hetch Hetchy Water Reaches San Francisco\", p. 42. Design mapping: docs/Hetchy Trail Historical Game Mapping.pdf, section 5."
assumption_note = "The brief's 'on failure' outcome is modeled as the delay choice, which returns this card to the deck so the vote can be attempted again - the tunnel cannot complete without it. Historically the 1932 bonds passed."
